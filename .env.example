# MongoDB bude připojena v pozdější fázi. Nepoužívejte skutečné údaje v tomto souboru.
MONGODB_URI=
MONGODB_DB_NAME=svatebni-wa

# Tajný svatební kód patří pouze do necommitovaného souboru .env.local.
WEDDING_CODE=

# Veřejná URL aplikace pro budoucí tvorbu magic linků.
APP_URL=http://localhost:3000
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=7

# Pouze pro vývoj; v produkci musí zůstat vypnuté.
ENABLE_DEV_MAGIC_LINK=false

# Volitelná konfigurace budoucího SMTP doručení.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Volitelný seznam správců; nebude obsahovat skutečné e-mailové adresy v repozitáři.
ADMIN_EMAILS=
