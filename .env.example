# Povinné serverové hodnoty. Skutečné údaje patří pouze do necommitovaného .env.local.
MONGODB_URI=
MONGODB_DB_NAME=svatebni-wa

# Tajný společný svatební kód – nikdy jej neukládejte do repozitáře.
WEDDING_CODE=

# Základní URL aplikace pro tvorbu magic linků; není určená pro klientský bundle.
APP_URL=http://localhost:3000

# Délky platnosti přihlášení.
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=7

# Pouze pro vývoj. V produkci musí zůstat false; magic link se pak nikdy nevrací klientovi.
ENABLE_DEV_MAGIC_LINK=false

# Produkční SMTP doručení magic linku. Lokální development tyto hodnoty nepotřebuje.
# U poskytovatele nastavte SMTP_HOST, port, přihlašovací údaje a ověřenou adresu odesílatele.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
